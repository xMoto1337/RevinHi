# The same 64-character hex secret as the SharedSecret constant in
# revinhi-performance/src/RevinHi.Core/Licensing/LicenseValidator.cs - keys generated here won't
# validate in the app unless this matches exactly.
LICENSE_SECRET_HEX=

# Your Gumroad seller ID (find it via the Gumroad API or your account settings). Ping webhooks are
# account-wide, so this is how the handler confirms a ping actually came from your account.
GUMROAD_SELLER_ID=

# Optional: the exact "product_name" Gumroad sends for RevinHi, so pings for a different product on
# the same Gumroad account (if you ever sell more than one thing) are ignored. Leave unset if RevinHi
# is the only product on the account.
GUMROAD_PRODUCT_NAME=

# Resend (resend.com) - used to email the generated key to the buyer.
RESEND_API_KEY=
EMAIL_FROM="RevinHi Performance <keys@yourdomain.com>"

# --- Wallpaper marketplace (RevinHi Wallpapers) -------------------------------------------------

# Create a free project at supabase.com, then run supabase/schema.sql in its SQL editor, and
# create two Storage buckets: "wallpapers" (private) and "wallpaper-thumbnails" (can be public).
# SUPABASE_URL is Project Settings -> API -> Project URL.
# SUPABASE_SERVICE_ROLE_KEY is Project Settings -> API -> service_role secret key - server-only,
# never expose this to the browser (it bypasses RLS entirely).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string you make up - gates /admin/wallpapers and the moderation API. Not a real
# auth system, just enough to keep the upload/approve endpoints from being wide open.
ADMIN_SECRET=

# Free key from https://www.pexels.com/api/ - only needed to run
# scripts/import-from-pexels.mjs (bulk-seeding the marketplace), not for the site itself.
PEXELS_API_KEY=
